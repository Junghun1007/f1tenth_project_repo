Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 34
    Fixed Frame: front_axle_bev
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Axes
      Name: Front axle ground origin
      Enabled: true
      Length: 0.3
      Radius: 0.01
      Reference Frame: front_axle_bev
    - Class: rviz_default_plugins/Marker
      Name: BEV ground footprint
      Enabled: true
      Marker Topic:
        Value: /point_cloud/bev_bounds
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
    - Class: rviz_default_plugins/PointCloud2
      Name: Tracked obstacle points
      Enabled: true
      Topic:
        Value: /point_cloud/points_tracked
        Depth: 1
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Queue Size: 1
      Style: Points
      Size (Pixels): 2
      Size (m): 0.005
      Alpha: 1
      Position Transformer: XYZ
      Color Transformer: RGB8
      Axis: X
      Use Fixed Frame: true
      Autocompute Value Bounds: false
      Min Value: 0
      Max Value: 4
      Decay Time: 0
      Selectable: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Current obstacle detections
      Enabled: false
      Topic:
        Value: /point_cloud/points_clusters
        Depth: 1
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Queue Size: 1
      Style: Points
      Size (Pixels): 2
      Size (m): 0.005
      Alpha: 1
      Position Transformer: XYZ
      Color Transformer: RGB8
      Axis: X
      Use Fixed Frame: true
      Autocompute Value Bounds: false
      Min Value: 0
      Max Value: 4
      Decay Time: 0
      Selectable: true
    - Class: rviz_default_plugins/PointCloud2
      Name: BEV region 3D points
      Enabled: false
      Topic:
        Value: /point_cloud/points_bev
        Depth: 1
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Queue Size: 1
      Style: Points
      Size (Pixels): 2
      Size (m): 0.005
      Alpha: 1
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: X
      Use Fixed Frame: true
      Autocompute Value Bounds: false
      Min Value: 0
      Max Value: 4
      Decay Time: 0
      Selectable: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Ground-filtered point cloud
      Enabled: false
      Topic:
        Value: /point_cloud/points_filtered
        Depth: 1
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Queue Size: 1
      Style: Points
      Size (Pixels): 2
      Size (m): 0.005
      Alpha: 1
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: X
      Use Fixed Frame: true
      Autocompute Value Bounds: false
      Min Value: 0
      Max Value: 4
      Decay Time: 0
      Selectable: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Original point cloud (includes ground)
      Enabled: false
      Topic:
        Value: /point_cloud/points
        Depth: 1
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Queue Size: 1
      Style: Points
      Size (Pixels): 2
      Size (m): 0.005
      Alpha: 1
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: X
      Use Fixed Frame: true
      Autocompute Value Bounds: false
      Min Value: 0
      Max Value: 4
      Decay Time: 0
      Selectable: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 4
      Focal Point:
        X: 1.5
        Y: 0
        Z: 0
      Pitch: 0.35
      Yaw: 3.14
      Target Frame: front_axle_bev
  Enabled: true
Window Geometry:
  Width: 1280
  Height: 850
