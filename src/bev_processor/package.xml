<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schemapath="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>bev_processor</name>
  <version>0.0.0</version>
  <description>Ground-plane BEV conversion for a rectified single camera image.</description>
  <maintainer email="ohslo@example.com">ohslo</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>libopencv-dev</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>camera_driver</exec_depend>
  <exec_depend>image_processor</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
