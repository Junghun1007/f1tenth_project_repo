<?xml version="1.0"?>
<package format="3">
  <name>longitudinal_autotune</name><version>0.1.0</version>
  <description>Isolated two-stop-line longitudinal controller experiments and bounded tuning.</description>
  <maintainer email="ohslo@example.com">ohslo</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>rclcpp_components</exec_depend><exec_depend>ament_index_python</exec_depend><exec_depend>launch_ros</exec_depend><exec_depend>launch</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-yaml</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>auto_control</exec_depend><exec_depend>camera_driver</exec_depend><exec_depend>bev_processor</exec_depend>
  <exec_depend>line_detactor</exec_depend><exec_depend>manual_control</exec_depend><exec_depend>vesc_bridge</exec_depend>
  <exec_depend>vehicle_bringup</exec_depend><exec_depend>vehicle_dynamics_monitor</exec_depend><exec_depend>joy_initializer</exec_depend>
  <!-- Reuse the controller's stop-request message contract; no traffic inference is launched. -->
  <exec_depend>traffic_detection_test</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
