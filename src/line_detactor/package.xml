<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>line_detactor</name>
  <version>0.0.0</version>
  <description>GPU Fast-SCNN preview for raw BEV lane segmentation.</description>
  <maintainer email="ohslo@example.com">ohslo</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <!-- Install NVIDIA's JetPack-compatible CUDA PyTorch separately. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
