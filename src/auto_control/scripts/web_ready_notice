#!/usr/bin/env python3
"""auto_drive 웹 화면이 열리면 Jetson 바탕화면(NoMachine)에 알림창으로 접속 주소를 띄운다.

  web_ready_notice <port> [--timeout 초]

포트가 열릴 때까지 1초마다 확인한다. 열리면 이 기기의 IP마다 http://IP:port 를 보여 주고,
제한 시간 안에 안 열리면 최근 launch 로그의 에러 줄과 컨테이너 상태를 경고창에 띄우고,
시작할 때 이미 포트가 열려 있으면 (이전 실행이 남음) 바로 경고한다. 화면이 없으면 터미널 출력만 한다.
"""
import argparse
import glob
import html
import os
import shutil
import socket
import subprocess
import sys
import time


def port_open(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.5)
        return s.connect_ex(("127.0.0.1", port)) == 0


def local_addresses():
    addresses = []
    try:
        out = subprocess.run(["hostname", "-I"], capture_output=True, text=True, timeout=2).stdout
        addresses = [a for a in out.split() if "." in a and not a.startswith(("127.", "172.17."))]
    except (OSError, subprocess.SubprocessError):
        pass
    if not addresses:   # hostname -I 가 없으면 기본 경로 인터페이스 주소 (패킷은 보내지 않음)
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
                s.connect(("192.0.2.1", 9))
                addresses = [s.getsockname()[0]]
        except OSError:
            pass
    # 192.168.x 같은 사설 LAN 주소를 먼저
    return sorted(set(addresses), key=lambda a: (not a.startswith("192.168."), a))


def port_owner(port):
    """포트를 잡고 있는 프로세스 (ss 출력 한 줄)."""
    try:
        out = subprocess.run(["ss", "-ltnpH", f"sport = :{port}"], capture_output=True, text=True, timeout=2).stdout.strip()
        return out.splitlines()[0] if out else ""
    except (OSError, subprocess.SubprocessError, IndexError):
        return ""


def started_before_us(owner, our_age):
    """포트를 잡은 프로세스가 이 알림 스크립트보다 먼저 떠 있었는지 (이전 실행이 남은 경우). 모르면 False."""
    import re
    m = re.search(r"pid=(\d+)", owner)
    if not m:
        return False
    try:
        etimes = float(subprocess.run(["ps", "-o", "etimes=", "-p", m.group(1)], capture_output=True, text=True, timeout=2).stdout)
    except (OSError, subprocess.SubprocessError, ValueError):
        return False
    return etimes > our_age + 3.0


def launch_errors(limit=8):
    """가장 최근 ros2 launch 로그에서 에러로 보이는 줄."""
    logs = sorted(glob.glob(os.path.expanduser("~/.ros/log/*/launch.log")), key=os.path.getmtime)
    if not logs:
        return []
    keys = ("ERROR", "error:", "died", "Exception", "exception", "Traceback", "terminate", "Failed", "failed", "not found")
    try:
        with open(logs[-1], errors="replace") as f:
            lines = [l.rstrip() for l in f if any(k in l for k in keys)]
    except OSError:
        return []
    return [l[-160:] for l in lines[-limit:]]


def containers_alive():
    try:
        out = subprocess.run(["pgrep", "-fa", "component_container"], capture_output=True, text=True, timeout=2).stdout
        return [l for l in out.splitlines() if "pgrep" not in l]
    except (OSError, subprocess.SubprocessError):
        return []


def show(title, text, warning=False):
    print(f"[web_ready_notice] {title}\n" + text.replace("<b>", "").replace("</b>", ""), flush=True)
    env = dict(os.environ)
    env.setdefault("DISPLAY", ":0")
    if shutil.which("zenity"):
        subprocess.Popen(["zenity", "--warning" if warning else "--info", "--no-wrap", "--title", title, "--text", text],
                         env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-u", "critical" if warning else "normal", title, text.replace("<b>", "").replace("</b>", "")],
                         env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("port", type=int)
    ap.add_argument("--timeout", type=float, default=180.0)
    a, _ = ap.parse_known_args()   # launch_ros가 붙이는 --ros-args 무시
    started = time.monotonic()
    owner = port_owner(a.port) if port_open(a.port) else ""
    if owner and started_before_us(owner, time.monotonic() - started):   # 이번 launch 전부터 포트를 잡고 있던 프로세스
        show("포트 %d이 이미 사용 중" % a.port,
             "이번 auto_drive가 뜨기 전에 이미 누가 포트를 잡고 있습니다 (이전 실행이 남았을 수 있음).\n"
             "새 auto_drive는 이 포트를 못 열고 종료될 수 있습니다.\n\n" + html.escape(owner or "(ss로 확인 못 함)") +
             "\n\n이전 실행을 모두 끈 뒤 다시 실행하세요:  pkill -f component_container", warning=True)
        return 2
    while time.monotonic() - started < a.timeout:
        if port_open(a.port):
            urls = [f"http://{ip}:{a.port}" for ip in local_addresses()] or [f"http://<jetson-ip>:{a.port}"]
            waited = time.monotonic() - started
            show("auto_drive 웹 화면 열림",
                 f"맥북 브라우저에서 접속:\n\n<b>{urls[0]}</b>" +
                 ("".join(f"\n{u}" for u in urls[1:]) if len(urls) > 1 else "") +
                 f"\n\n(포트 {a.port}, 시작 후 {waited:.0f}초)")
            return 0
        time.sleep(1.0)
    errors = launch_errors()
    alive = containers_alive()
    detail = ("\n\n최근 launch 로그의 에러 줄:\n" + "\n".join(html.escape(l) for l in errors)) if errors else \
        "\n\n최근 launch 로그(~/.ros/log/latest/launch.log)에서 에러 줄을 찾지 못했습니다."
    detail += "\n\ncomponent_container 프로세스: " + (f"{len(alive)}개 실행 중" if alive else "없음 (컨테이너가 죽었거나 안 떴음)")
    show("auto_drive 웹 화면이 안 열림",
         f"{a.timeout:.0f}초 동안 포트 {a.port}이 열리지 않았습니다.\nlaunch 터미널의 [ERROR] / process has died 줄을 확인하세요." + detail,
         warning=True)
    return 1


if __name__ == "__main__":
    sys.exit(main())
