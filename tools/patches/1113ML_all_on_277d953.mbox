-    sensor_fps: 70.0
+    # 60: RGB+스테레오 깊이+IMU를 함께 받을 때 OAK 장치 CPU(LeonCSS)가 70에서는 포화되어 프레임이 버려진다
+    # (oak_fps_bench: 70 요청 → 실제 약 66 fps, 누락 5%; 60 요청 → 60 fps, 누락 0). tunnel_enabled에서도 이 값을 쓴다
+    sensor_fps: 60.0
     width: 1280
     height: 800
 
@@ -30,7 +32,9 @@ camera_driver:
     imu_topic: "/camera/imu"
