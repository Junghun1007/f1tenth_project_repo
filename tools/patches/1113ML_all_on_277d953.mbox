     # BNO086 calibrated accelerometer+gyroscope output.
-    imu_rate_hz: 400.0
+    # 200 Hz: 영상 안정화(샘플 간격 5 ms < 프레임 IMU 나이 한계 12 ms)·요레이트에 충분하고,
+    # 400 Hz 대비 OAK 장치 CPU 부하가 줄어 RGB 누락이 43 → 12로 감소 (oak_fps_bench)
+    imu_rate_hz: 200.0
