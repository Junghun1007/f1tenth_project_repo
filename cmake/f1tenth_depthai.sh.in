# generated by DepthaiWorkspace.cmake; sourced by install/setup.bash
# Move the selected SDK to the front and remove duplicates, preserving all
# other entries (including paths containing spaces). No global ldconfig change.
_f1tenth_depthai_prepend() {
  _f1tenth_depthai_result="$1"
  _f1tenth_depthai_tail="$2"
  while [ -n "$_f1tenth_depthai_tail" ]; do
    _f1tenth_depthai_item="${_f1tenth_depthai_tail%%:*}"
    if [ -n "$_f1tenth_depthai_item" ] && [ "$_f1tenth_depthai_item" != "$1" ]; then
      _f1tenth_depthai_result="$_f1tenth_depthai_result:$_f1tenth_depthai_item"
    fi
    case "$_f1tenth_depthai_tail" in
      *:*) _f1tenth_depthai_tail="${_f1tenth_depthai_tail#*:}" ;;
      *) break ;;
    esac
  done
}

_f1tenth_depthai_prepend "@F1TENTH_DEPTHAI_PREFIX@" "${CMAKE_PREFIX_PATH:-}"
export CMAKE_PREFIX_PATH="$_f1tenth_depthai_result"
_f1tenth_depthai_prepend "@F1TENTH_DEPTHAI_LIBRARY_DIR@" "${@F1TENTH_DEPTHAI_LOADER_VARIABLE@:-}"
export @F1TENTH_DEPTHAI_LOADER_VARIABLE@="$_f1tenth_depthai_result"

unset -f _f1tenth_depthai_prepend
unset _f1tenth_depthai_result _f1tenth_depthai_tail _f1tenth_depthai_item
